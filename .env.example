# Qloo Insights + entity search (server-side only)
QLOO_API_KEY=

# Hackathon keys must use this base URL (default in code)
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# Track B — Convex (from `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Same as NEXT_PUBLIC_CONVEX_SITE_URL — required on Vercel for @convex-dev/auth server routes
CONVEX_SITE_URL=

# Track B — Resend (set on Convex deployment, not Next.js)
# RESEND_API_KEY=
# SEND_HOLD_FROM_EMAIL=

# Convex Auth (set on Convex deployment via `npx @convex-dev/auth`, not in this file)
# JWT_PRIVATE_KEY
# JWKS
# SITE_URL
